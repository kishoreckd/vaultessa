# Vaultessa backend configuration
# Loaded by app/core/config.py (Settings).
# Keep NAME=value syntax for dotenv compatibility.

# Application
# Runtime identity and environment. Restart the backend after edits.
ENVIRONMENT=development
APP_NAME=Vaultessa API
APP_VERSION=0.1.0

# Database
# Local Docker exposes PostgreSQL on port 5433.
DATABASE_URL=postgresql+psycopg://passvault:passvault@localhost:5433/passvault

# URLs and CORS
# Use deployed HTTPS origins in production. APP_BASE_URL controls email links.
APP_BASE_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private server secrets
# Keep private and out of Git. Use separate random secrets.
JWT_ACCESS_SECRET=
PRELOGIN_SECRET=
MFA_ENCRYPTION_KEY=

# Authentication and sessions
# Token lifetimes and login lockout policy.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=pv_refresh
MFA_TOKEN_TTL_MINUTES=5
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15
DEFAULT_KDF_ITERATIONS=600000

# Scrypt hashing
# New hashes use these factors; stored hashes retain theirs. Memory must support both.
SCRYPT_N=32768
SCRYPT_R=8
SCRYPT_P=1
SCRYPT_DKLEN=32
SCRYPT_MAXMEM=67108864

# Email verification and recovery
# Lifetimes and abuse protection. Vault recovery also needs the saved recovery key.
VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=15
EMAIL_RESEND_COOLDOWN_SECONDS=60
MAX_PASSWORD_RESET_ATTEMPTS=5

# Authenticator and recovery codes
# Supported authenticator format: 30-second period, 6 digits.
TOTP_PERIOD_SECONDS=30
TOTP_DIGITS=6
TOTP_ISSUER=Vaultessa
RECOVERY_CODE_COUNT=10

# Rate limits
# Per-process request counts; the shared window is measured in seconds.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_REQUESTS=300
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_LOOKUP_REQUESTS=30
RATE_LIMIT_PUBLIC_SHARE_REQUESTS=60
RATE_LIMIT_MACHINE_REQUESTS=120

# SMTP delivery
# Dev Mailpit: SMTP 1026, inbox UI 8026. Brevo: 587 with STARTTLS and verified sender. Keep credentials private.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=Vaultessa <no-reply@vaultessa.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10

# Expiry reminder worker
# Requires running backend and SMTP. Poll interval is seconds; batch size is items.
EXPIRY_REMINDERS_ENABLED=true
EXPIRY_REMINDER_POLL_SECONDS=300
EXPIRY_REMINDER_BATCH_SIZE=20

# Sharing and developer tokens
# Maximum lifetimes in days; guest code attempt limit.
EXTERNAL_SHARE_MAX_LIFETIME_DAYS=90
EXTERNAL_SHARE_MAX_CODE_ATTEMPTS=5
API_TOKEN_MAX_LIFETIME_DAYS=730

# Firebase SMS verification
# Optional. Empty project ID disables SMS. Endpoints verify Firebase phone tokens.
FIREBASE_PROJECT_ID=
FIREBASE_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
FIREBASE_ISSUER_BASE_URL=https://securetoken.google.com
FIREBASE_MAX_AUTH_AGE_SECONDS=300
FIREBASE_JWKS_CACHE_SECONDS=3600
FIREBASE_TOKEN_LEEWAY_SECONDS=30
