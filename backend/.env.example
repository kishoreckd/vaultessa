ENVIRONMENT=development

# docker-compose maps Postgres to host port 5433 (see POSTGRES_PORT)
DATABASE_URL=postgresql+psycopg://passvault:passvault@localhost:5433/passvault

# Required — the API refuses to start without them. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET=
PRELOGIN_SECRET=
MFA_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
DEFAULT_KDF_ITERATIONS=600000

# Comma-separated list of allowed origins for the web vault
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_BASE_URL=http://127.0.0.1:5173

# Outgoing email. Dev: Mailpit from docker-compose (inbox at http://127.0.0.1:8026)
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=Vaultessa <no-reply@vaultessa.local>
RATE_LIMIT_ENABLED=true
