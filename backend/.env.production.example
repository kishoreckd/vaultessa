# Vaultessa PRODUCTION backend environment-variable template
# Never put real credentials in this example or commit a populated env file.
# Set these on the backend hosting service; Docker does not copy .env files.
# For a standalone server, copy this to backend/.env and fill required blanks.
# Settings reads backend/.env, NOT .env.production automatically.
# Required before deployment: DATABASE_URL, three independent secrets, SMTP_USERNAME,
# SMTP_PASSWORD (Brevo SMTP key), SMTP_FROM (verified sender), and actual API routing.
# APP_BASE_URL is the public frontend origin, not the backend URL.
# Restart/redeploy after changes. Do not reuse local-development secrets.

# Application
# Runtime identity and environment. Restart the backend after edits.
ENVIRONMENT=production
APP_NAME=Vaultessa API
APP_VERSION=0.1.0

# Database
# REQUIRED: production PostgreSQL connection URI; use the provider TLS settings.
# Example format: postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# URLs and CORS
# Public HTTPS frontend origin; no /login path. APP_BASE_URL controls email links.
APP_BASE_URL=https://vaultessa.vercel.app
CORS_ORIGINS=https://vaultessa.vercel.app

# Private server secrets
# REQUIRED: keep private and out of Git. Use three different random secrets.
# Generate each once: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep MFA_ENCRYPTION_KEY stable: changing it makes existing TOTP seeds unreadable.
JWT_ACCESS_SECRET=
PRELOGIN_SECRET=
MFA_ENCRYPTION_KEY=

# Authentication and sessions
# Token lifetimes and login lockout policy.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=pv_refresh
MFA_TOKEN_TTL_MINUTES=5
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15
DEFAULT_KDF_ITERATIONS=600000

# Scrypt hashing
# New hashes use these factors; stored hashes retain theirs. Memory must support both.
SCRYPT_N=32768
SCRYPT_R=8
SCRYPT_P=1
SCRYPT_DKLEN=32
SCRYPT_MAXMEM=67108864

# Email verification and recovery
# Lifetimes and abuse protection. Vault recovery also needs the saved recovery key.
VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=15
EMAIL_RESEND_COOLDOWN_SECONDS=45
# Six-digit email codes expire after 10 minutes; five incorrect attempts require a resend.
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
MAX_PASSWORD_RESET_ATTEMPTS=5

# Authenticator and recovery codes
# Supported authenticator format: 30-second period, 6 digits.
TOTP_PERIOD_SECONDS=30
TOTP_DIGITS=6
TOTP_ISSUER=Vaultessa
RECOVERY_CODE_COUNT=10

# Rate limits
# Per-process request counts; the shared window is measured in seconds.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_REQUESTS=300
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_LOOKUP_REQUESTS=30
RATE_LIMIT_PUBLIC_SHARE_REQUESTS=60
RATE_LIMIT_MACHINE_REQUESTS=120

# SMTP delivery
# Brevo SMTP uses STARTTLS on 587. Credentials are the SMTP login and SMTP key.
# SMTP_FROM must be a sender verified in your Brevo account, e.g. Vaultessa <no-reply@YOUR_DOMAIN>.
# REQUIRED: fill SMTP_USERNAME, SMTP_PASSWORD and SMTP_FROM; confirm the host permits outbound SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# Expiry reminder worker
# Requires running backend and SMTP. Poll interval is seconds; batch size is items.
EXPIRY_REMINDERS_ENABLED=true
EXPIRY_REMINDER_POLL_SECONDS=300
EXPIRY_REMINDER_BATCH_SIZE=20

# Sharing and developer tokens
# Maximum lifetimes in days; guest code attempt limit.
EXTERNAL_SHARE_MAX_LIFETIME_DAYS=90
EXTERNAL_SHARE_MAX_CODE_ATTEMPTS=5
API_TOKEN_MAX_LIFETIME_DAYS=730

# Firebase SMS verification
# Optional. Empty project ID disables SMS. Endpoints verify Firebase phone tokens.
FIREBASE_PROJECT_ID=
FIREBASE_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
FIREBASE_ISSUER_BASE_URL=https://securetoken.google.com
FIREBASE_MAX_AUTH_AGE_SECONDS=300
FIREBASE_JWKS_CACHE_SECONDS=3600
FIREBASE_TOKEN_LEEWAY_SECONDS=30

# Organisations and verified domains
# Invitation lifetime, capacity and DNS verification controls.
ORGANIZATION_INVITATION_TTL_DAYS=7
ORGANIZATION_INVITATION_COOLDOWN_SECONDS=60
ORGANIZATION_MAX_MEMBERS=500
ORGANIZATION_DOMAIN_VERIFICATION_DAYS=30
ORGANIZATION_DNS_RESOLVER_URL=https://dns.google/resolve
ORGANIZATION_DNS_TIMEOUT_SECONDS=5

# Disabled in production; local Mailpit is not an outgoing production mail server.
MAILPIT_BASE_URL=

# Wrong email codes: after EMAIL_CODE_MAX_ATTEMPTS, block codes for this many minutes (120 = 2 hours)
EMAIL_CODE_LOCKOUT_MINUTES=120
# Email outbox: retry unsent emails (server restart / SMTP failure) every N seconds, up to N attempts
EMAIL_OUTBOX_WORKER_ENABLED=true
EMAIL_OUTBOX_POLL_SECONDS=60
EMAIL_OUTBOX_MAX_ATTEMPTS=8
