# Vaultessa frontend LOCAL configuration
# Copy to .env.local. Restart Vite after edits.
# VITE_* values are public and embedded in the browser build. Never put credentials here.

# Public same-origin API path; cookies require the frontend /api proxy.
VITE_API_BASE_PATH=/api

# Development server only; not bundled into the browser.
DEV_API_PROXY_TARGET=http://127.0.0.1:8010
