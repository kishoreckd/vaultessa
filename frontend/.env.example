# Vaultessa frontend LOCAL environment; copy to .env.local and restart Vite.
# Backend origin for the local Vite proxy; not bundled into the browser.
BACKEND_URL=http://127.0.0.1:8010

# VITE_* values are public and embedded in the browser build.
VITE_API_BASE_PATH=/api

# Optional public landing-page analytics. Set the real GA4 web stream ID.
# Keep Enhanced Measurement OFF for this stream (especially history/form tracking).
VITE_GA_MEASUREMENT_ID=

# Optional Firebase web app configuration (Firebase console > Project settings).
# This initializes the web app only; it does not enable SMS sign-in or replace vault auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
