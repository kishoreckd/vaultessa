# Vaultessa frontend PRODUCTION configuration
# Set this in the frontend hosting environment before building, then redeploy.
# The browser calls https://vaultessa.vercel.app/api through the same-origin rewrite.
VITE_API_BASE_PATH=/api

# Set the deployed backend destination in frontend/vercel.json (/api/:path* rewrite).
# It still needs the actual backend hostname; no SMTP credential belongs here.
# SMTP_*, DATABASE_URL, JWT_ACCESS_SECRET, PRELOGIN_SECRET and MFA_ENCRYPTION_KEY
# belong exclusively to the backend hosting environment.
