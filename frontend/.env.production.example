# Vaultessa frontend PRODUCTION environment
# Set these in the frontend Vercel project environment, then redeploy.
# Vercel evaluates vercel.ts using BACKEND_URL; no hostname changes in source files.
BACKEND_URL=https://vaultessa-backend.vercel.app

# Browser requests remain on the frontend origin so session cookies work.
VITE_API_BASE_PATH=/api

# Do not put SMTP credentials, database URLs, JWT secrets or Swagger passwords here.
# They belong to the backend hosting environment only.

# Optional public landing integrations; enter real project values before redeploying.
VITE_GA_MEASUREMENT_ID=
